# --- Database (PostgreSQL) ---
# Local dev via docker-compose: docker compose up -d db
DATABASE_URL="postgresql://timberland:timberland@localhost:5432/timberland?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-32-byte-base64-secret"
AUTH_TRUST_HOST="true"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"

# --- Email / notifications (optional; falls back to console transport if unset) ---
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="Timberland <no-reply@timberland.example>"

# --- Optional Google OAuth (leave blank to disable) ---
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
