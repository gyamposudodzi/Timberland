// Timberland — own-fleet courier & delivery platform
// Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Two roles only: a normal account (CUSTOMER) and a full-control administrator
// (ADMIN). There is no intermediate staff/back-office role.
enum Role {
  CUSTOMER
  ADMIN
}

enum ShipmentStatus {
  CREATED
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  PAY_ON_DELIVERY
  CASH
  CARD_ON_DELIVERY
  INVOICE
}

enum NotificationChannel {
  EMAIL
}

enum NotificationLogStatus {
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  emailVerified Boolean   @default(false)
  verifyToken   String?
  verifyTokenAt DateTime?
  resetToken    String?
  resetTokenAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses         Address[]
  shipments         Shipment[]
  notificationPrefs NotificationPreference[]
  recordedEvents    TrackingEvent[]    @relation("RecordedByUser")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Pricing: zones + service levels + rate rules
// ---------------------------------------------------------------------------

model ServiceZone {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  basePrice Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("USD")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateRules RateRule[]
  addresses Address[]
}

model ServiceLevel {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  slaDays        Int      @default(3)
  priceMultiplier Decimal @default(1) @db.Decimal(6, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rateRules RateRule[]
  shipments Shipment[]
}

model RateRule {
  id             String  @id @default(cuid())
  zoneId         String
  serviceLevelId String
  perKg          Decimal @db.Decimal(8, 2)
  perPiece       Decimal @default(0) @db.Decimal(8, 2)
  minPrice       Decimal @db.Decimal(10, 2)

  zone         ServiceZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  serviceLevel ServiceLevel @relation(fields: [serviceLevelId], references: [id], onDelete: Cascade)

  @@unique([zoneId, serviceLevelId])
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

model Address {
  id          String   @id @default(cuid())
  userId      String?
  label       String?
  contactName String
  phone       String
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String
  country     String   @default("US")
  zoneId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user               User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone               ServiceZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  shipmentsAsSender    Shipment[]   @relation("SenderAddress")
  shipmentsAsRecipient Shipment[]   @relation("RecipientAddress")

  @@index([userId])
  @@index([postalCode])
}

// ---------------------------------------------------------------------------
// Shipments & parcels
// ---------------------------------------------------------------------------

model Shipment {
  id              String         @id @default(cuid())
  trackingNumber  String         @unique
  userId          String?
  status          ShipmentStatus @default(CREATED)
  serviceLevelId  String
  senderAddressId String
  recipientAddressId String
  pickupDate      DateTime?
  price           Decimal        @db.Decimal(10, 2)
  currency        String         @default("USD")
  paymentMethod   PaymentMethod  @default(PAY_ON_DELIVERY)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceLevel    ServiceLevel   @relation(fields: [serviceLevelId], references: [id])
  senderAddress   Address        @relation("SenderAddress", fields: [senderAddressId], references: [id])
  recipientAddress Address       @relation("RecipientAddress", fields: [recipientAddressId], references: [id])
  parcels         Parcel[]
  trackingEvents  TrackingEvent[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Parcel {
  id            String   @id @default(cuid())
  shipmentId    String
  description   String
  weightKg      Decimal  @db.Decimal(8, 3)
  lengthCm      Decimal? @db.Decimal(8, 2)
  widthCm       Decimal? @db.Decimal(8, 2)
  heightCm      Decimal? @db.Decimal(8, 2)
  pieces        Int      @default(1)
  declaredValue Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// ---------------------------------------------------------------------------
// Tracking events (public timeline + internal feed)
// ---------------------------------------------------------------------------

model TrackingEvent {
  id           String         @id @default(cuid())
  shipmentId   String
  statusCode   ShipmentStatus
  location     String?
  note         String?
  occurredAt   DateTime       @default(now())
  isPublic     Boolean        @default(true)
  source       String         @default("SYSTEM")
  recordedById String?
  createdAt    DateTime       @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("RecordedByUser", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([shipmentId, isPublic])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model NotificationPreference {
  id          String              @id @default(cuid())
  userId      String
  channel     NotificationChannel @default(EMAIL)
  events      String[]
  enabled     Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
}

model NotificationLog {
  id         String                @id @default(cuid())
  userId     String?
  shipmentId String?
  channel    NotificationChannel   @default(EMAIL)
  event      String
  to         String
  subject    String
  status     NotificationLogStatus @default(SKIPPED)
  error      String?
  createdAt  DateTime              @default(now())

  @@index([shipmentId])
  @@index([userId])
}
